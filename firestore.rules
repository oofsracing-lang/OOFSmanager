rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Allow public read access (for Dashboard/Standings)
    match /seasons/{seasonId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Allow public read access to calculated standings
    match /standings/{seasonId} {
      allow read: if true;
    }

    // Qualifying Submissions
    // Allow public read (for drivers to see their results/Admin)
    // Allow public create (for drivers to submit)
    // Update/Delete: Admin only
    match /qualifying/{submissionId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if request.auth != null;
    }

    // Default deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
